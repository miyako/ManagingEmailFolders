.venv/
build/
__pycache__/
.DS_Store
ehthumbs.db
Thumbs.db

# 4D runtime / user data / caches (projects live in demo/<Name>/; data/ at the root is demo data and is tracked)
demo/*/[dD][aA][tT][aA]/
demo/*/Logs/
demo/*/userPreferences.*/
demo/*/Project/DerivedData/
demo/*/Libraries/
# Machine-specific settings and local OAuth configuration; source settings remain tracked.
demo/*/Settings/
demo/*/Resources/client_secrets.json
demo/*/Resources/oauth.local.json

# Tools provisioned by the skills in .agents (4dtools). Do NOT ignore the whole tools/ folder:
# the localisation pipeline in tools/*.py is committed.
/tools/4dcatalog/
/tools/4dform/
/tools/4dlsp/
/tools/4dlang/
/tools/4dcli/
